# OpenRouter API Configuration
# Get your free API key from https://openrouter.io/keys
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# Optional: Flask Configuration
FLASK_PORT=5000
FLASK_DEBUG=False

# Optional: Frontend Configuration  
FRONTEND_PORT=8000

# AI Models: 3 free models queried simultaneously
MODEL_1=nvidia/nemotron-3-nano-30b-a3b:free
MODEL_1_API_KEY=your-api-key-here

MODEL_2=llama-3.1-8b-instant
MODEL_2_API_KEY=your-groq-api-key-here
MODEL_2_BASE_URL=https://api.groq.com/openai/v1/chat/completions

MODEL_3=gemini-3-flash-preview
MODEL_3_API_KEY=your-gemini-api-key-here
MODEL_3_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
